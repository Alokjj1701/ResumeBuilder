# ============================================================
# Resume Builder — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=resumebuilder
DB_USER=resumeuser
DB_PASSWORD=resumepass

# ── Backend ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── JWT (REQUIRED in production — generate a random 32+ char string) ─────────
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars!!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Cookies (set to true when behind HTTPS in production) ─────────────────────
COOKIE_SECURE=false

# ── CORS (comma-separated — add your Railway frontend URL in production) ───────
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000,http://frontend,http://frontend:80

# ── Frontend ─────────────────────────────────────────────────
# Leave empty to use Nginx reverse proxy (recommended for Docker Compose).
# Set to a full URL only when deploying the frontend separately from the backend.
# Example for Railway: VITE_API_BASE_URL=https://your-backend.up.railway.app
API_BASE_URL=
